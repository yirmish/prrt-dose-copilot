# Copy to `.env` (same folder you run python from) and fill in.
# NEVER commit `.env`. The token is not source code.
#
# Get the token: https://ux.priorlabs.ai -> accept the licence -> API / token.
# Needed only for the TabPFN-2.5 / 2.6 / 3 checkpoints. The TabPFN-V2 arm needs none.
TABPFN_TOKEN=

# Optional: keep the ~2 GB of downloaded checkpoints somewhere you choose
# TABPFN_MODEL_CACHE_DIR=C:\path\to\project\tabpfn_models

# Optional: never try to open a browser (set to 1 on a headless machine)
# TABPFN_NO_BROWSER=

# Optional: point the code at the data if it is not under .\data\
# PRRT_DATA_ROOT=C:\path\to\project\data\Deidentified_Export_2026-09-07
